<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:simpleType name="money"><xs:restriction base="xs:decimal"><xs:fractionDigits value="2"/><xs:minInclusive value="0"/></xs:restriction></xs:simpleType>
  <xs:complexType name="head"><xs:sequence>
    <xs:element name="TIN" type="xs:string"/><xs:element name="ORGNM" type="xs:string"/>
    <xs:element name="POINTNM" type="xs:string"/><xs:element name="POINTADDR" type="xs:string"/>
    <xs:element name="ORDERDATE" type="xs:string"/><xs:element name="ORDERTIME" type="xs:string"/>
    <xs:element name="ORDERNUM" type="xs:nonNegativeInteger"/><xs:element name="CASHDESKNUM" type="xs:string"/>
    <xs:element name="CASHREGISTERNUM" type="xs:string"/><xs:element name="CASHIER" type="xs:string"/>
    <xs:element name="MAC" type="xs:string" minOccurs="0"/><xs:element name="VER" type="xs:positiveInteger"/>
  </xs:sequence></xs:complexType>
  <xs:element name="CHECK"><xs:complexType><xs:sequence>
    <xs:element name="HEAD" type="head"/>
    <xs:element name="BODY" minOccurs="0"><xs:complexType><xs:sequence>
      <xs:element name="ROW" maxOccurs="unbounded"><xs:complexType><xs:sequence>
        <xs:element name="CODE" type="xs:string"/><xs:element name="NAME" type="xs:string"/>
        <xs:element name="UNITCD" type="xs:positiveInteger"/><xs:element name="UNITNM" type="xs:string"/>
        <xs:element name="AMOUNT" type="xs:decimal"/><xs:element name="PRICE" type="money"/>
        <xs:element name="COST" type="money"/><xs:element name="LETTERS" type="xs:string" minOccurs="0"/>
      </xs:sequence><xs:attribute name="ROWNUM" type="xs:positiveInteger" use="required"/></xs:complexType></xs:element>
    </xs:sequence></xs:complexType></xs:element>
    <xs:element name="PAY"><xs:complexType><xs:sequence><xs:element name="ROW"><xs:complexType><xs:sequence>
      <xs:element name="PAYFORMCD" type="xs:nonNegativeInteger"/><xs:element name="PAYFORMNM" type="xs:string"/><xs:element name="SUM" type="money"/>
    </xs:sequence><xs:attribute name="ROWNUM" type="xs:positiveInteger" use="required"/></xs:complexType></xs:element></xs:sequence></xs:complexType></xs:element>
    <xs:element name="TOTAL"><xs:complexType><xs:sequence><xs:element name="SUM" type="money"/></xs:sequence></xs:complexType></xs:element>
  </xs:sequence><xs:attribute name="CT" type="xs:nonNegativeInteger" use="required"/></xs:complexType></xs:element>
</xs:schema>