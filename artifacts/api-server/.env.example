# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/maisonhd

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=8080
NODE_ENV=development
LOG_LEVEL=info

# ─── Auth ─────────────────────────────────────────────────────────────────────
# REQUIRED — must be a long random string in production
JWT_SECRET=change-me-to-a-long-random-string-in-production
ENCRYPTION_KEY=change-me-to-32-hex-chars-in-prod

# ─── Super-admin account (auto-seeded on first start) ─────────────────────────
SUPER_ADMIN_EMAIL=owner@maisonhd.com
SUPER_ADMIN_PASSWORD=change-me-in-production

# ─── Public URLs (set to your deployed domain) ────────────────────────────────
APP_URL=https://your-domain.com
API_BASE_URL=https://your-domain.com
PUBLIC_API_URL=https://your-domain.com
FRONTEND_URL=https://your-domain.com
API_URL=https://your-domain.com
WIDGET_BASE_URL=https://your-domain.com
# Automatically available on Replit — do not set manually
# REPLIT_DEV_DOMAIN=

# ─── AI (OpenAI-compatible) ───────────────────────────────────────────────────
# Via Replit AI Integrations proxy (recommended):
AI_INTEGRATIONS_OPENAI_API_KEY=
AI_INTEGRATIONS_OPENAI_BASE_URL=

# Or direct OpenAI key:
OPENAI_API_KEY=

# ─── Voice / Speech ───────────────────────────────────────────────────────────
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM   # default: Rachel

# ─── Payments — LiqPay ────────────────────────────────────────────────────────
# Per-tenant keys are stored in legal_entities table.
# These global keys serve as a fallback for public booking payments.
LIQPAY_PUBLIC_KEY=
LIQPAY_PRIVATE_KEY=

# ─── Payments — Stripe ────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=

# ─── Object Storage ───────────────────────────────────────────────────────────
DEFAULT_OBJECT_STORAGE_BUCKET_ID=
PRIVATE_OBJECT_DIR=
PUBLIC_OBJECT_SEARCH_PATHS=

# ─── Web Push (VAPID) ─────────────────────────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@your-domain.com

# ─── Notifications ────────────────────────────────────────────────────────────
# Telegram bot for demo requests (MaisonHD landing)
MAISONHD_TG_BOT_TOKEN=
MAISONHD_TG_CHAT_ID=

# Generic Telegram bot (presence enables integration)
TELEGRAM_BOT_TOKEN=

# SMTP email (presence enables email notifications)
SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# ─── External integrations ────────────────────────────────────────────────────
SERVIO_API_KEY=

# ─── Telephony ────────────────────────────────────────────────────────────────
PUBLIC_URL=https://your-domain.com
